<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Snake.io Black Arena</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
        body {
            background-color: #050505;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            touch-action: none;
        }
        #ui-container {
            position: absolute;
            top: 15px;
            left: 15px;
            right: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
            pointer-events: none;
        }
        .score-card {
            background: rgba(20, 20, 20, 0.8);
            padding: 8px 16px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 16px;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            pointer-events: auto;
        }
        .btn {
            background: #00e676;
            color: #000;
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            pointer-events: auto;
            box-shadow: 0 0 10px rgba(0, 230, 118, 0.4);
        }
        canvas {
            display: block;
            background-color: #050505;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
        }
        /* Virtual Joystick Bulat Presisi */
        #joystick-zone {
            position: absolute;
            bottom: 35px;
            left: 50%;
            transform: translateX(-50%);
            width: 130px;
            height: 130px;
            background: rgba(255, 255, 255, 0.04);
            border: 2px solid rgba(0, 230, 118, 0.2);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
            backdrop-filter: blur(2px);
        }
        #joystick-knob {
            width: 55px;
            height: 55px;
            background: radial-gradient(circle, #00e676 0%, #00a152 100%);
            border-radius: 50%;
            box-shadow: 0 0 15px rgba(0, 230, 118, 0.6);
            position: absolute;
            pointer-events: none;
        }
        #game-over-modal {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.88);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 20;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        #game-over-modal.show {
            opacity: 1;
            pointer-events: auto;
        }
        #game-over-modal h1 {
            font-size: 32px;
            color: #ff1744;
            margin-bottom: 10px;
            text-shadow: 0 0 10px rgba(255, 23, 68, 0.5);
        }
    </style>
</head>
<body>

    <div id="ui-container">
        <div class="score-card">Skor: <span id="score">0</span></div>
        <button class="btn" id="soundBtn" onclick="toggleSound()">🔊 Suara</button>
    </div>

    <!-- Layar Game -->
    <canvas id="gameCanvas"></canvas>

    <!-- Virtual Joystick Controls -->
    <div id="joystick-zone">
        <div id="joystick-knob"></div>
    </div>

    <!-- Modal Game Over -->
    <div id="game-over-modal">
        <h1>GAME OVER</h1>
        <p style="margin-bottom: 20px; font-size: 18px;">Skor Akhir: <span id="finalScore">0</span></p>
        <button class="btn" onclick="restartGame()">Main Lagi</button>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Variabel Utama Game
        let snake = [];
        let snakeLength = 35; // Segmen tubuh lebih panjang untuk efek kelancaran
        let headX, headY;
        let angle = 0;
        let targetAngle = 0;
        let speed = 3.5;
        let score = 0;
        let foods = [];
        let gameRunning = false;
        let soundEnabled = true;

        const snakeRadius = 11;
        const segmentSpacing = 4; // Jarak antar segmen rapat khas Snake.io

        // Input Keyboard State
        const keys = { ArrowLeft: false, ArrowRight: false, KeyA: false, KeyD: false };

        // Audio Web API
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playEatSound() {
            if (!soundEnabled) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(450, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(850, audioCtx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.08);
            } catch(e) {}
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById("soundBtn").innerText = soundEnabled ? "🔊 Suara" : "🔇 Bisu";
        }

        function init() {
            headX = canvas.width / 2;
            headY = canvas.height / 2;
            angle = 0;
            targetAngle = 0;
            snakeLength = 35;
            snake = [];
            
            // Inisialisasi awal posisi tubuh
            for (let i = 0; i < snakeLength * segmentSpacing; i++) {
                snake.push({ x: headX - i, y: headY });
            }

            score = 0;
            document.getElementById("score").innerText = score;
            document.getElementById("game-over-modal").classList.remove("show");

            // Makanan di Arena
            foods = [];
            for (let i = 0; i < 50; i++) spawnFood();

            gameRunning = true;
            requestAnimationFrame(gameLoop);
        }

        function spawnFood() {
            foods.push({
                x: Math.random() * (canvas.width - 40) + 20,
                y: Math.random() * (canvas.height - 40) + 20,
                radius: Math.random() * 3 + 4,
                color: `hsl(${Math.random() * 360}, 100%, 60%)`,
                isApple: Math.random() < 0.2
            });
        }

        function gameLoop() {
            if (!gameRunning) return;

            update();
            render();

            requestAnimationFrame(gameLoop);
        }

        function update() {
            // Rotasi Keyboard Smooth
            if (keys.ArrowLeft || keys.KeyA) targetAngle -= 0.07;
            if (keys.ArrowRight || keys.KeyD) targetAngle += 0.07;

            // Interpolasi Sudut agar Pergerakan Ular Mulus (Fluid Turning)
            let diff = targetAngle - angle;
            angle += diff * 0.15;

            // Pergerakan Kepala Ular
            headX += Math.cos(angle) * speed;
            headY += Math.sin(angle) * speed;

            // BORDER WALL DETECTION (Game Over jika menyentuh batas canvas)
            if (headX - snakeRadius < 0 || headX + snakeRadius > canvas.width || 
                headY - snakeRadius < 0 || headY + snakeRadius > canvas.height) {
                gameOver();
                return;
            }

            // Memasukkan jejak koordinat kepala
            snake.unshift({ x: headX, y: headY });
            while (snake.length > snakeLength * segmentSpacing) {
                snake.pop();
            }

            // Makanan
            for (let i = foods.length - 1; i >= 0; i--) {
                let f = foods[i];
                let dist = Math.hypot(headX - f.x, headY - f.y);
                if (dist < f.radius + snakeRadius) {
                    score += f.isApple ? 20 : 5;
                    snakeLength += f.isApple ? 4 : 2;
                    document.getElementById("score").innerText = score;
                    playEatSound();
                    foods.splice(i, 1);
                    spawnFood();
                }
            }

            // Tabrakan Tubuh Sendiri (Self Collision)
            let minIndex = 25 * segmentSpacing;
            for (let i = minIndex; i < snake.length; i += segmentSpacing) {
                let seg = snake[i];
                let dist = Math.hypot(headX - seg.x, headY - seg.y);
                if (dist < snakeRadius * 1.2) {
                    gameOver();
                    return;
                }
            }
        }

        function render() {
            // Background Hitam Polos Arena
            ctx.fillStyle = "#050505";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Garis Grid Neon Halus
            ctx.strokeStyle = "rgba(255, 255, 255, 0.03)";
            ctx.lineWidth = 1;
            const gridSize = 40;
            for (let x = 0; x < canvas.width; x += gridSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }
            for (let y = 0; y < canvas.height; y += gridSize) {
                ctx.beginPath();
                ctx.moveTo(0, y); ctx.lineTo(canvas.width, y);
                ctx.stroke();
            }

            // Gambar Makanan
            for (let f of foods) {
                ctx.shadowBlur = 10;
                ctx.shadowColor = f.color;
                ctx.fillStyle = f.color;

                if (f.isApple) {
                    ctx.beginPath();
                    ctx.arc(f.x, f.y, 7, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = "#795548";
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(f.x, f.y - 7);
                    ctx.lineTo(f.x + 2, f.y - 10);
                    ctx.stroke();
                } else {
                    ctx.beginPath();
                    ctx.arc(f.x, f.y, f.radius, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
            ctx.shadowBlur = 0;

            // Render Tubuh Ular Ala Snake.io (Dari Ekor ke Kepala)
            for (let i = snakeLength - 1; i >= 0; i--) {
                let idx = i * segmentSpacing;
                if (idx >= snake.length) continue;
                let seg = snake[idx];

                // Efek Ukuran Segmen Tapering (Mengecil Ke Ekor)
                let sizeRatio = 1 - (i / snakeLength) * 0.35;
                let currentRadius = snakeRadius * sizeRatio;

                ctx.beginPath();
                ctx.arc(seg.x, seg.y, currentRadius, 0, Math.PI * 2);
                
                // Gradasi Warna Segmen Bermotif Neon
                ctx.fillStyle = (i % 2 === 0) ? "#00e676" : "#00b0ff";
                ctx.fill();
                ctx.lineWidth = 1;
                ctx.strokeStyle = "rgba(0,0,0,0.3)";
                ctx.stroke();
            }

            // Render Kepala Ular
            let head = snake[0];
            if (head) {
                ctx.shadowBlur = 15;
                ctx.shadowColor = "#00e676";
                ctx.fillStyle = "#00e676";
                ctx.beginPath();
                ctx.arc(head.x, head.y, snakeRadius + 1, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;

                // Mata Ular Berorientasi Sesuai Arah Gerak (Angle)
                ctx.fillStyle = "#ffffff";
                let eyeOffset = 5;
                let eyeAngleOffset = 0.5;

                let eyeX1 = head.x + Math.cos(angle - eyeAngleOffset) * eyeOffset;
                let eyeY1 = head.y + Math.sin(angle - eyeAngleOffset) * eyeOffset;
                let eyeX2 = head.x + Math.cos(angle + eyeAngleOffset) * eyeOffset;
                let eyeY2 = head.y + Math.sin(angle + eyeAngleOffset) * eyeOffset;

                ctx.beginPath();
                ctx.arc(eyeX1, eyeY1, 3.5, 0, Math.PI * 2);
                ctx.arc(eyeX2, eyeY2, 3.5, 0, Math.PI * 2);
                ctx.fill();

                // Pupil Hitam Mata
                ctx.fillStyle = "#000000";
                let pupilX1 = eyeX1 + Math.cos(angle) * 1.5;
                let pupilY1 = eyeY1 + Math.sin(angle) * 1.5;
                let pupilX2 = eyeX2 + Math.cos(angle) * 1.5;
                let pupilY2 = eyeY2 + Math.sin(angle) * 1.5;

                ctx.beginPath();
                ctx.arc(pupilX1, pupilY1, 1.8, 0, Math.PI * 2);
                ctx.arc(pupilX2, pupilY2, 1.8, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function gameOver() {
            gameRunning = false;
            document.getElementById("finalScore").innerText = score;
            document.getElementById("game-over-modal").classList.add("show");
        }

        function restartGame() {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            init();
        }

        // Virtual Joystick Controller System
        const joystickZone = document.getElementById("joystick-zone");
        const joystickKnob = document.getElementById("joystick-knob");
        let joystickActive = false;
        let touchStartX = 0, touchStartY = 0;

        joystickZone.addEventListener("touchstart", (e) => {
            joystickActive = true;
            let touch = e.touches[0];
            let rect = joystickZone.getBoundingClientRect();
            touchStartX = rect.left + rect.width / 2;
            touchStartY = rect.top + rect.height / 2;
            updateJoystick(touch.clientX, touch.clientY);
        });

        window.addEventListener("touchmove", (e) => {
            if (!joystickActive) return;
            let touch = e.touches[0];
            updateJoystick(touch.clientX, touch.clientY);
        });

        window.addEventListener("touchend", () => {
            joystickActive = false;
            joystickKnob.style.transform = `translate(0px, 0px)`;
        });

        function updateJoystick(clientX, clientY) {
            let dx = clientX - touchStartX;
            let dy = clientY - touchStartY;
            let dist = Math.hypot(dx, dy);
            let maxRadius = 38;

            if (dist > maxRadius) {
                dx = (dx / dist) * maxRadius;
                dy = (dy / dist) * maxRadius;
            }

            joystickKnob.style.transform = `translate(${dx}px, ${dy}px)`;
            targetAngle = Math.atan2(dy, dx);
        }

        // Kontrol Keyboard (Panah & WASD)
        window.addEventListener("keydown", (e) => {
            if (e.code in keys) keys[e.code] = true;
        });

        window.addEventListener("keyup", (e) => {
            if (e.code in keys) keys[e.code] = false;
        });

        window.onload = init;
    </script>
</body>
</html>
